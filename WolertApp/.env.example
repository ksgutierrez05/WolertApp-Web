# Variables de entorno de ejemplo para WolertApp
# Copia este archivo a .env y completa los valores reales.

# URL base del backend
VITE_API_URL=http://localhost:5039

# Token de Mapbox (obtener en https://account.mapbox.com/)
VITE_MAPBOX_TOKEN=

# Client ID de Google OAuth (obtener en Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=
